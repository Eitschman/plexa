# Server
PORT=3000
NODE_ENV=production
DATA_DIR=./data

# Docker Compose only — host port mapped to container port 3000
HOST_PORT=3000
# Pre-built image override (compose.image.yaml only; default: ghcr.io/rupisaini123/plexa:latest)
# PLEXA_IMAGE=ghcr.io/rupisaini123/plexa:0.2.0
# Used for AES-256-GCM token encryption, session CSRF, and signed media URLs
APP_SECRET=change-me-to-a-long-random-string

# Initial admin (used on first boot if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Optional Plex seed values (prefer Sign in with Plex in the UI)
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Public HTTPS URL for Alexa skill endpoint and signed media links (user-managed TLS)
PUBLIC_URL=https://your-domain.example.com

# Alexa skill application ID from Developer Console (enforced when set)
ALEXA_SKILL_ID=
